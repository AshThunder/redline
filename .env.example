# Qwen via Bitget hackathon gateway (OpenAI-compatible)
LLM_API_KEY=
LLM_BASE_URL=https://hackathon.bitgetops.com/v1
LLM_MODEL=qwen3.8-max

# Bitget endpoints. Set HTTPS_PROXY if bitget.com is not reachable from your network.
BITGET_REST_BASE=https://api.bitget.com
BITGET_MCP_URL=https://agent.bitget.com/mcp
HTTPS_PROXY=

# Route *.bitget.com to reachable Cloudflare edge IPs when your ISP DNS-blocks Bitget. Leave empty elsewhere.
BITGET_PIN_IPS=

# Optional. Watchtower texts you when a tripwire fires (while Redline is open).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional. Publish the verdict ledger to a public GitHub repo (owner/name).
LEDGER_GITHUB_TOKEN=
LEDGER_GITHUB_REPO=
